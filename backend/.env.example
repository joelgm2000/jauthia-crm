# Copia este archivo como backend/.env y completa los valores. NUNCA subas .env a git.

# --- Servidor ---
NODE_ENV=development
PORT=3000
# En desarrollo se usa el PostgreSQL local de `npm run db`. En el VPS lo define docker-compose.
DATABASE_URL=postgresql://crm:crm_dev_local@localhost:5433/jauthia_crm
# Firma de las sesiones:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Cifrado de los tokens de WhatsApp/Meta/Telegram de cada cliente (32 bytes en base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ¡Guárdala! Si se pierde, cada cliente debe volver a pegar sus tokens.
SECRETS_KEY=
# Dueño de la plataforma: el único que puede nombrar super administradores.
PLATFORM_OWNER_EMAIL=
# Orígenes del frontend permitidos (separados por coma)
CORS_ORIGINS=http://localhost:4200
# URL pública del servidor (https). La usan los webhooks y las imágenes del catálogo.
PUBLIC_BASE_URL=

# --- Chat web ---
# Sitios donde se puede pegar el widget (separados por coma). * = cualquiera.
WEBCHAT_ORIGINS=*
# Solo si hay un proxy (Caddy/Nginx) delante: TRUST_PROXY=1. Sin proxy déjalo vacío
# (si no, cualquiera podría inventar su IP y evadir el bloqueo de intentos).
TRUST_PROXY=

# Los tokens de WhatsApp, Messenger, Instagram y Telegram ya NO van aquí:
# cada cliente los pega en Canales y se guardan cifrados en la base de datos.
