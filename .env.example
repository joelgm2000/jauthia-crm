# Variables para el VPS (docker compose). Copia como .env y completa. NUNCA subas .env a git.

# Dominio o subdominio que apunta a la IP del VPS (ej: crm.jauthia.com)
DOMAIN=

# Genera claves largas con:  openssl rand -base64 36
POSTGRES_PASSWORD=
JWT_SECRET=
# Cifrado de los tokens de cada cliente (32 bytes):  openssl rand -base64 32
# ¡Guárdala en un lugar seguro! Si se pierde, los clientes deben volver a pegar sus tokens.
SECRETS_KEY=

# Tu correo: el único que puede crear super administradores.
PLATFORM_OWNER_EMAIL=

# Sitios donde se puede pegar el widget de chat (separados por coma). * = cualquiera.
WEBCHAT_ORIGINS=*

# IA de imágenes (opcional): clave de Google AI Studio (aistudio.google.com → Get API key).
# Se activa por cliente en el súper admin ("IA de imágenes"). Vacía = apagada para todos.
GEMINI_API_KEY=
# Espacio para fotos y videos por cliente, en MB.
MEDIA_QUOTA_MB=1024
